#!/bin/sh

echo "🔍 Running pre-push quality checks (Pint & PHPStan)..."

# 1. Check code formatting with Laravel Pint
vendor/bin/pint --parallel --test
if [ $? -ne 0 ]; then
    echo ""
    echo "❌ PUSH ABORTED: Code formatting checks failed!"
    echo "👉 Run 'vendor/bin/pint --format agent' to automatically fix code style issues before pushing."
    echo ""
    exit 1
fi

# 2. Check types with PHPStan
vendor/bin/phpstan analyse --memory-limit=1G
if [ $? -ne 0 ]; then
    echo ""
    echo "❌ PUSH ABORTED: PHPStan static analysis found errors!"
    echo "👉 Fix the static analysis errors above before pushing."
    echo ""
    exit 1
fi

echo "✅ All pre-push checks passed! Pushing to remote..."
exit 0
